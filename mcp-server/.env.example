# Paystack TEST secret key (Dashboard > Settings > API Keys & Webhooks). Live keys are refused.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret Chord sends as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional. Paystack needs an email; customers without one get wa<phone>@<this domain>.
PLACEHOLDER_EMAIL_DOMAIN=example.com

# Local only: PAYSTACK_MODE=mock uses an in-memory fake Paystack (no key needed).
# PAYSTACK_MODE=mock
# PUBLIC_BASE_URL=http://localhost:3000
